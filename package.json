{
  "name": "ugo-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "build:android:arm64": "cd android && gradlew.bat app:assembleDebug -PreactNativeArchitectures=arm64-v8a",
    "build:android:release": "cd android && gradlew.bat app:assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@supabase/supabase-js": "^2.48.1",
    "base64-arraybuffer": "^1.0.2",
    "expo": "57.0.21",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image-picker": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webrtc": "^124.0.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.12",
    "typescript": "^5.7.2"
  }
}
